# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Anthropic API key (required)
ANTHROPIC_API_KEY=

# Model to use for all LLM calls (optional, default defined in config.py)
NEXTMATCH_MODEL=

# Local storage directories (optional, defaults shown)
NEXTMATCH_DATA_DIR=data
NEXTMATCH_OUTPUTS_DIR=outputs

# Logging level: DEBUG, INFO, WARNING, ERROR (optional, defaults to INFO)
NEXTMATCH_LOG_LEVEL=INFO
